{
  "manifest_version": 3,
  "name": "Spark OTP Autofill",
  "version": "1.3.4",
  "description": "Automatically extracts and autofills verification codes from Spark Desktop via local CLI daemon across any website.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_title": "Spark OTP Settings",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": ["extension/content.js"],
      "css": ["extension/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
